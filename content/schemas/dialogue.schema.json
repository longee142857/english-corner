{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dialogue.schema.json",
  "title": "Dialogue",
  "description": "One object inside an array file at content/dialogues/*.json. manifest.json in that folder is not a dialogue file.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "title",
    "level",
    "domain",
    "themes",
    "situation",
    "roles",
    "turns",
    "followUps",
    "usefulPhrases",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^dlg-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "level": {
      "type": "string",
      "enum": ["A1", "A2", "B1", "B2", "C1"]
    },
    "domain": {
      "type": "string",
      "enum": [
        "daily-life",
        "campus",
        "travel",
        "academic",
        "career",
        "culture",
        "exam",
        "interview",
        "debate"
      ]
    },
    "themes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "situation": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "turns": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["role", "text"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "followUps": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "usefulPhrases": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "source": { "type": "string", "minLength": 1 }
  }
}
