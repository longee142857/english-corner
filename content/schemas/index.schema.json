{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "index.schema.json",
  "title": "Content index",
  "description": "Light catalog written to content/index.json. Passage, script, and turn text are omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "counts", "topics", "dialogues", "vocabulary", "pieces"],
  "properties": {
    "version": { "const": 1 },
    "note": { "type": "string" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topics",
        "dialogues",
        "turns",
        "vocabEntries",
        "readings",
        "listenings",
        "debates"
      ],
      "properties": {
        "topics": { "type": "integer", "minimum": 0 },
        "dialogues": { "type": "integer", "minimum": 0 },
        "turns": { "type": "integer", "minimum": 0 },
        "vocabEntries": { "type": "integer", "minimum": 0 },
        "readings": { "type": "integer", "minimum": 0 },
        "listenings": { "type": "integer", "minimum": 0 },
        "debates": { "type": "integer", "minimum": 0 }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "level", "domain", "themes"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "level": { "type": "string" },
          "domain": { "type": "string" },
          "themes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "dialogues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "level", "domain", "themes", "roles"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "level": { "type": "string" },
          "domain": { "type": "string" },
          "themes": { "type": "array", "items": { "type": "string" } },
          "roles": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "headword", "type", "level", "theme", "packId"],
        "properties": {
          "id": { "type": "string" },
          "headword": { "type": "string" },
          "type": { "type": "string" },
          "level": { "type": "string" },
          "theme": { "type": "string" },
          "packId": { "type": "string" }
        }
      }
    },
    "pieces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "level", "domain", "themes"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["reading", "listening", "debate"]
          },
          "title": { "type": "string" },
          "level": { "type": "string" },
          "domain": { "type": "string" },
          "themes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
