{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "listening.schema.json",
  "title": "Listening piece",
  "description": "One object inside an array file at content/listening/*.json. Questions use the same shape as reading questions.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "kind",
    "title",
    "level",
    "domain",
    "themes",
    "roles",
    "script",
    "questions",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^listen-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kind": { "const": "listening" },
    "title": { "type": "string", "minLength": 1 },
    "level": {
      "type": "string",
      "enum": ["A1", "A2", "B1", "B2", "C1"]
    },
    "domain": {
      "type": "string",
      "enum": [
        "daily-life",
        "campus",
        "travel",
        "academic",
        "career",
        "culture",
        "exam",
        "interview",
        "debate"
      ]
    },
    "themes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "script": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["role", "text"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "question", "options", "answer", "explanation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "answer": { "type": "integer", "minimum": 0 },
          "explanation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source": { "type": "string", "minLength": 1 }
  }
}
